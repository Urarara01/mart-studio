# Mart Studio — copia este archivo como ".env" (en esta misma carpeta) y pon tu clave.
# ABRIR-MART-STUDIO.cmd lo crea solo la primera vez y lo abre en el Bloc de notas.

# Tu clave de MartLLM (https://martllm.com)
martllm-key = ull_pega_tu_clave_aqui
martllm-base-url = https://api.martllm.com/v1

# Opcional: login para abrir la app desde otros equipos (LAN / Tailscale).
# Si los dejas vacíos, la app solo escucha en 127.0.0.1 (este equipo).
user =
pass =
